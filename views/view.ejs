
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student List</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #141e46, #4831a8, #7928ca);
            padding: 40px 20px;
        }

        .container {
            width: 100%;
            max-width: 1150px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        h1 {
            color: #25254a;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #888;
            font-size: 14px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .student-count {
            color: #555;
            font-size: 14px;
        }

        .register-btn {
            display: inline-block;
            padding: 12px 18px;
            background: linear-gradient(135deg, #5145cd, #8b35d1);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            transition: 0.3s;
        }

        .register-btn:hover {
            background: linear-gradient(135deg, #4035b5, #7025b5);
            transform: translateY(-2px);
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #eee;
            border-radius: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }

        thead {
            background: linear-gradient(135deg, #5145cd, #8b35d1);
            color: white;
        }

        th {
            padding: 16px;
            text-align: left;
            font-size: 13px;
            font-weight: bold;
            white-space: nowrap;
        }

        td {
            padding: 15px 16px;
            color: #444;
            font-size: 14px;
            border-bottom: 1px solid #eee;
        }

        tbody tr {
            transition: background 0.2s;
        }

        tbody tr:hover {
            background: #f7f5ff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .id {
            color: #6741d9;
            font-weight: bold;
        }

        .delete-form {
            margin: 0;
        }

        .delete-btn {
            padding: 9px 13px;
            background: #ef4444;
            color: white;
            border: none;
            border-radius: 7px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .delete-btn:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }

        .empty {
            text-align: center;
            padding: 35px;
            color: #888;
        }

        .footer {
            text-align: center;
            margin-top: 25px;
            color: #999;
            font-size: 12px;
        }

        @media (max-width: 600px) {
            body {
                padding: 20px 12px;
            }

            .container {
                padding: 22px 15px;
                border-radius: 14px;
            }

            h1 {
                font-size: 23px;
            }

            .top-bar {
                align-items: stretch;
                flex-direction: column;
            }

            .register-btn {
                text-align: center;
            }

            th, td {
                padding: 12px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>Student List</h1>
            <p class="subtitle">Manage your registered students</p>
        </div>

        <div class="top-bar">
            <p class="student-count">
                Total students: <strong><%= student.length %></strong>
            </p>

            <a href="/" class="register-btn">
                + Register Student
            </a>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>ID Number</th>
                        <th>Last Name</th>
                        <th>First Name</th>
                        <th>Age</th>
                        <th>Address</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (student && student.length > 0) { %>

                        <% student.forEach((data) => { %>
                            <tr>
                                <td class="id"><%= data.idnum %></td>
                                <td><%= data.lastname %></td>
                                <td><%= data.firstname %></td>
                                <td><%= data.age %></td>
                                <td><%= data.adress %></td>

                                <td>
                                    <form
                                        action="/delete/<%= data.idnum %>"
                                        method="POST"
                                        class="delete-form"
                                        onsubmit="return confirm('Are you sure you want to delete this student?');"
                                    >
                                        <button
                                            type="submit"
                                            class="delete-btn"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>

                    <% } else { %>

                        <tr>
                            <td colspan="6" class="empty">
                                No students registered yet.
                                <br><br>
                                Click "Register Student" to add one.
                            </td>
                        </tr>

                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="footer">
            Student Registration System &copy; 2026
        </div>

    </div>

</body>
</html>
